[user]
	name = George Troulis
	email = georgetroulis@gmail.com

[core]
    autocrlf = input

[push]
    default = current

[alias]
	ahist = log --graph --oneline --decorate --all -n 20
	alhist = log --graph --oneline --decorate --all
	hist = log --graph --oneline --decorate  -n 20
	lhist = log --graph --oneline --decorate

[pull]
	rebase = false
[init]
	defaultBranch = main
